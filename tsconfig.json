{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@designcodeio/threeui": ["./vendor/threeui/BestsellersEntry.tsx"]
    }
  },
  "include": ["src", "vendor/threeui/BestsellersEntry.tsx", "vite.config.ts"]
}
